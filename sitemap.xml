---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign pages = "/,/services/,/projects/,/about/,/news/" | split: "," %}{% for u in pages %}  <url><loc>{{ site.url }}{{ u }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
{% endfor %}{% for p in site.posts %}  <url><loc>{{ site.url }}{{ p.url }}</loc><lastmod>{{ p.last_modified | default: p.date | date: "%Y-%m-%d" }}</lastmod></url>
{% endfor %}</urlset>
